// Bloco de Pedra Filosofal: cristal opaco MUITO reflexivo (mais que o ferro e que os blocos de gema) e com brilho fraco.
materialMask = OSIEBCA;    // reflexo de Fresnel intenso (borda reflete mais)
smoothnessG = 0.97;        // reflexo do sol/lua (0 = fosco, 1 = espelho)
smoothnessD = smoothnessG; // reflexo na tela
highlightMult = 3.0;       // brilho do reflexo do sol
emission = 0.35;           // luz propria fraca do cristal
