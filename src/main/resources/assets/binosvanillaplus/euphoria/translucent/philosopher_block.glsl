// Bloco de Pedra Filosofal: cristal reflexivo e um pouco translucido (como vidro/ametista polida).
// A transparencia vem do alfa da textura (miolo ~75%, moldura ~92%); a cor do bloco tinge o que fica atras.
smoothnessG = 0.9;        // reflexo do sol/lua (0 = fosco, 1 = espelho)
highlightMult = 2.5;      // brilho do reflexo do sol
reflectMult = 0.8;        // reflexo na tela
